<Window x:Class="Natsx.Controller.Receiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NATSX Controller Receiver"
        Width="720"
        Height="620"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <StackPanel>
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="NATSX Controller" />
            <TextBlock Margin="0,6,0,28"
                       Opacity="0.7"
                       Text="Windows Receiver" />

            <Border Padding="20"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="Receiver runtime" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.72"
                               Text="Starting receiver…" />
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Padding="20"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,16,14">
                        <TextBlock Opacity="0.58"
                                   Text="Smart Auto" />
                        <TextBlock x:Name="SmartAutoStateText"
                                   Margin="0,4,0,0"
                                   FontWeight="SemiBold"
                                   Text="Starting" />
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,14">
                        <TextBlock Opacity="0.58"
                                   Text="Active transport" />
                        <TextBlock x:Name="ActiveTransportText"
                                   Margin="0,4,0,0"
                                   FontWeight="SemiBold"
                                   Text="None" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,16,14">
                        <TextBlock Opacity="0.58"
                                   Text="Backup transports" />
                        <TextBlock x:Name="BackupTransportsText"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="None" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,0,14">
                        <TextBlock Opacity="0.58"
                                   Text="Virtual Xbox controller" />
                        <TextBlock x:Name="VirtualControllerText"
                                   Margin="0,4,0,0"
                                   FontWeight="SemiBold"
                                   Text="Starting" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Grid.ColumnSpan="2">
                        <TextBlock Opacity="0.58"
                                   Text="Trusted Android controllers" />
                        <TextBlock x:Name="TrustedControllerCountText"
                                   Margin="0,4,0,0"
                                   Text="0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="PairingPanel"
                    Margin="0,20,0,0"
                    Padding="20"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    CornerRadius="14"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="Pair Android controller" />
                    <TextBlock Margin="0,8,0,0"
                               Opacity="0.72"
                               Text="Confirm only if this 6-digit code matches the code shown on your phone." />
                    <TextBlock x:Name="PairingCodeText"
                               Margin="0,14,0,0"
                               FontSize="36"
                               FontWeight="Bold"
                               Text="" />
                    <TextBlock x:Name="PairingPeerText"
                               Margin="0,6,0,14"
                               Opacity="0.58"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button Width="120"
                                Padding="12,7"
                                Click="OnPairingConfirmClicked"
                                Content="Confirm" />
                        <Button Width="120"
                                Margin="10,0,0,0"
                                Padding="12,7"
                                Click="OnPairingRejectClicked"
                                Content="Reject" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
