<Window x:Class="Natsx.Controller.Receiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NATSX Controller | Windows Receiver"
        Width="1040" Height="820"
        MinWidth="880" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F3F7"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#FF282333"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF807A8C"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF9D89CF"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF7963AE"/>
        <SolidColorBrush x:Key="OutlineBrush" Color="#FFE4E0E9"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFAFAFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="17"/>
            <Setter Property="MinHeight" Value="100"/>
        </Style>
        <Style x:Key="EyebrowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="17,10"/>
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="MinWidth" Value="94"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#FF50465F"/>
            <Setter Property="Background" Value="#FFEDE9F3"/>
        </Style>
        <Style x:Key="OptionCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1190" Margin="34,26,34,30">
            <StackPanel>
                <!-- Brand: the same airy shell, lavender and mint as the Android controller. -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="47" Height="47" CornerRadius="14" Background="#FF9D89CF">
                            <Grid>
                                <Border Width="29" Height="29" Background="#FFFAFAFC" CornerRadius="10" Opacity="0.20"/>
                                <TextBlock Text="N" FontSize="27" FontWeight="Black" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="13,3,0,0">
                            <TextBlock Text="NATSX" FontWeight="Bold" FontSize="20" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="CONTROLLER  /  WINDOWS RECEIVER" FontWeight="SemiBold" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FFFAFAFC" BorderBrush="{StaticResource OutlineBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="13,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#FFD9D5DF" Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnectionStateText" Text="WAITING FOR CONTROLLER"
                                       FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Text="Receiver dashboard" FontSize="30" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="A cleaner home for your phone controller. Built around reliable play."
                           Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,7,0,22"/>

                <!-- Pairing is intentionally above the fold; never hide the security decision. -->
                <Border x:Name="PairingPanel" Style="{StaticResource CardStyle}"
                        Margin="0,0,0,14" BorderBrush="#FFB7A5E2" BorderThickness="2"
                        Background="#FFF8F4FF" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="PAIRING REQUEST" Foreground="{StaticResource AccentDarkBrush}"
                                       FontWeight="Bold" FontSize="10"/>
                            <TextBlock Text="Confirm your Android controller" Style="{StaticResource SectionTitle}" Margin="0,7,0,0"/>
                            <TextBlock Text="Make sure this 6-digit code matches the code on your phone."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                            <TextBlock x:Name="PairingPeerText" TextWrapping="Wrap" Margin="0,10,0,0"
                                       FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock x:Name="PairingCodeText" Text="" FontSize="32" FontWeight="Bold"
                                       FontFamily="Consolas" TextAlignment="Center" Foreground="{StaticResource InkBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Confirm" Style="{StaticResource ActionButton}"
                                        Click="OnPairingConfirmClicked"/>
                                <Button Content="Reject" Margin="8,0,0,0" Style="{StaticResource SubtleButton}"
                                        Click="OnPairingRejectClicked"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="ErrorPanel" Style="{StaticResource CardStyle}"
                        BorderBrush="#FFF1B2BC" Background="#FFFFF5F6"
                        Margin="0,0,0,14" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="RECEIVER NEEDS ATTENTION" FontSize="10" FontWeight="Bold" Foreground="#FFB3495C"/>
                            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{StaticResource InkBrush}"/>
                        </StackPanel>
                        <Button x:Name="RetryReceiverButton" Grid.Column="1" Content="Retry receiver"
                                VerticalAlignment="Center" Style="{StaticResource ActionButton}"
                                Click="OnRetryReceiverClicked"/>
                    </Grid>
                </Border>

                <!-- Live summary. Keep the runtime-owned status and diagnostic fields intact. -->
                <Border Style="{StaticResource CardStyle}" Padding="25" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="215"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,1,18,0" VerticalAlignment="Center">
                            <TextBlock Text="LIVE RECEIVER STATUS" Style="{StaticResource EyebrowText}"/>
                            <TextBlock x:Name="StatusText" Text="Starting receiver…" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,13,0,0"/>
                            <Border Background="#FFF0EBF8" CornerRadius="12" Padding="12,9"
                                    HorizontalAlignment="Left" Margin="0,20,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#FF9D89CF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="SMART AUTO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}" Margin="0,0,9,0"/>
                                    <TextBlock x:Name="SmartAutoStateText" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}" Text="Starting"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#FFF3EFF9" CornerRadius="18" Padding="14">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Lightweight gamepad-inspired linework; no animated rendering. -->
                                <Grid Width="155" Height="100">
                                    <Border Width="152" Height="87" Background="#FFFAF9FC" BorderBrush="#FFD3CAE6"
                                            BorderThickness="2" CornerRadius="40" VerticalAlignment="Center"/>
                                    <Ellipse Width="31" Height="31" Fill="#FFE7DDF7" Stroke="#FFB7A5E2" StrokeThickness="2"
                                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="27,26,0,0"/>
                                    <Ellipse Width="17" Height="17" Fill="#FF9D89CF"
                                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="34,26,0,0"/>
                                    <Grid Width="33" Height="33" HorizontalAlignment="Left" Margin="23,11,0,0" VerticalAlignment="Top">
                                        <Rectangle Fill="#FF8F7BC4" Height="9" Width="32" RadiusX="3" RadiusY="3" VerticalAlignment="Center"/>
                                        <Rectangle Fill="#FF8F7BC4" Width="9" Height="32" RadiusX="3" RadiusY="3" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <Ellipse Width="14" Height="14" Fill="#FF92DFA0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,31,21,0"/>
                                    <Ellipse Width="14" Height="14" Fill="#FFB7A5E2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,38,26"/>
                                    <Ellipse Width="14" Height="14" Fill="#FFD7CCE9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,26"/>
                                    <Ellipse Width="14" Height="14" Fill="#FF9D89CF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,21,51"/>
                                    <Ellipse Width="22" Height="22" Fill="#FFE7DDF7" Stroke="#FFB7A5E2" StrokeThickness="1"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="N" FontSize="12" FontWeight="Bold" Foreground="#FF7963AE"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="ACTIVE TRANSPORT" Style="{StaticResource EyebrowText}"
                                           TextAlignment="Center" Margin="0,9,0,0"/>
                                <TextBlock x:Name="ActiveTransportText" Text="None" FontSize="22"
                                           FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="LATENCY / RTT" Style="{StaticResource EyebrowText}"/>
                            <TextBlock x:Name="RoundTripTimeText" Text="—" Margin="0,12,0,0" Style="{StaticResource MetricValue}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="JITTER" Style="{StaticResource EyebrowText}"/>
                            <TextBlock x:Name="JitterText" Text="—" Margin="0,12,0,0" Style="{StaticResource MetricValue}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="PACKET LOSS" Style="{StaticResource EyebrowText}"/>
                            <TextBlock x:Name="PacketLossText" Text="—" Margin="0,12,0,0" Style="{StaticResource MetricValue}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource MetricCard}">
                        <StackPanel><TextBlock Text="INPUT RATE" Style="{StaticResource EyebrowText}"/>
                            <TextBlock x:Name="InputRateText" Text="0 Hz" Margin="0,12,0,0" Style="{StaticResource MetricValue}"/></StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Connection paths" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Smart Auto chooses the healthiest trusted link."
                                       Margin="0,5,0,18" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            <Border Padding="14" Background="#FFF8F7FA" BorderBrush="#FFEAE6EE" BorderThickness="1" CornerRadius="15" Margin="0,0,0,10">
<Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border x:Name="UsbDot" Grid.Column="0" Background="#FFD9D5DF" CornerRadius="3"/>
 <StackPanel Grid.Column="2">
   <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="USB Direct"/>
   <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="Priority 01 · direct cable"/>
 </StackPanel>
 <Border Grid.Column="3" Padding="10,6" CornerRadius="10" Background="#FFEFEDF2" VerticalAlignment="Center">
   <TextBlock x:Name="UsbLinkStateText" Foreground="#FF827D8A" FontWeight="SemiBold" FontSize="10" Text="NOT ACTIVE" />
 </Border>
</Grid>
</Border>
                            <Border Padding="14" Background="#FFF8F7FA" BorderBrush="#FFEAE6EE" BorderThickness="1" CornerRadius="15" Margin="0,0,0,10">
<Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border x:Name="WifiDot" Grid.Column="0" Background="#FFD9D5DF" CornerRadius="3"/>
 <StackPanel Grid.Column="2">
   <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="Wi-Fi"/>
   <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="Priority 02 · local network"/>
 </StackPanel>
 <Border Grid.Column="3" Padding="10,6" CornerRadius="10" Background="#FFEFEDF2" VerticalAlignment="Center">
   <TextBlock x:Name="WifiLinkStateText" Foreground="#FF827D8A" FontWeight="SemiBold" FontSize="10" Text="NOT ACTIVE" />
 </Border>
</Grid>
</Border>
                            <Border Padding="14" Background="#FFF8F7FA" BorderBrush="#FFEAE6EE" BorderThickness="1" CornerRadius="15" Margin="0,0,0,10">
<Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border x:Name="BluetoothDot" Grid.Column="0" Background="#FFD9D5DF" CornerRadius="3"/>
 <StackPanel Grid.Column="2">
   <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="Bluetooth"/>
   <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="Priority 03 · wireless fallback"/>
 </StackPanel>
 <Border Grid.Column="3" Padding="10,6" CornerRadius="10" Background="#FFEFEDF2" VerticalAlignment="Center">
   <TextBlock x:Name="BluetoothLinkStateText" Foreground="#FF827D8A" FontWeight="SemiBold" FontSize="10" Text="NOT ACTIVE" />
 </Border>
</Grid>
</Border>
                            <TextBlock Text="READY / BACKUP LINKS" Style="{StaticResource EyebrowText}" Margin="0,7,0,7"/>
                            <TextBlock x:Name="BackupTransportsText" Text="None" Foreground="{StaticResource InkBrush}"
                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Controller health" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Essential session information at a glance."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18" FontSize="12"/>
                            <TextBlock Text="VIRTUAL XBOX CONTROLLER" Style="{StaticResource EyebrowText}"/>
                            <TextBlock x:Name="VirtualControllerText" Text="Starting" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" Margin="0,7,0,15"/>
                            <Border Background="#FFF2EFF6" Height="1" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="RECONNECTS" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock x:Name="ReconnectCountText" Text="0" Style="{StaticResource MetricValue}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="LATEST HANDOVER" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock x:Name="RecentHandoverText" Text="None" FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Trusted controller" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Pair once, reconnect automatically." Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#FFE7DDF7" Padding="9,6" CornerRadius="9"
                                        VerticalAlignment="Top">
                                    <TextBlock x:Name="TrustedControllerCountText" Text="0 trusted" FontSize="10"
                                               FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="TrustedControllerText" Text="None" Margin="0,18,0,12"
                                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <Button x:Name="ForgetControllerButton" Content="Forget controller" MinWidth="140"
                                    Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" IsEnabled="False"
                                    Click="OnForgetControllerClicked"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Receiver preferences" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Make it work quietly in the background." Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" Margin="0,5,0,14"/>
                            <CheckBox x:Name="StartWithWindowsCheckBox"
                                      Content="Launch with Windows" Style="{StaticResource OptionCheckBox}"
                                      Checked="OnStartWithWindowsChanged" Unchecked="OnStartWithWindowsChanged"/>
                            <CheckBox x:Name="CloseToTrayCheckBox" Margin="0,12,0,0"
                                      Content="Keep running when window closes" Style="{StaticResource OptionCheckBox}"
                                      Checked="OnCloseToTrayChanged" Unchecked="OnCloseToTrayChanged"/>
                            <TextBlock Text="Minimizing sends the receiver to the tray. Use Exit from the tray menu to stop it."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,13,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="NATSX  ·  DESIGNING IDEAS INTO EXPERIENCE"
                               Style="{StaticResource EyebrowText}"/>
                    <TextBlock Grid.Column="1" Text="Local first  /  Low latency  /  Smart Auto"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>