<Window x:Class="Natsx.Controller.Receiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NATSX Controller Receiver"
        Width="760"
        Height="520"
        MinWidth="620"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closed="OnClosed">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="NATSX Controller" />
            <TextBlock Margin="0,6,0,0"
                       Opacity="0.7"
                       Text="Windows Receiver" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="22"
                BorderBrush="#33000000"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="StatusTitle"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="Starting..." />
                    <TextBlock x:Name="StatusDetail"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.72"
                               Text="Preparing receiver." />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,0,10"
                               Opacity="0.65"
                               Text="Virtual controller" />
                    <TextBlock x:Name="VirtualControllerValue"
                               Grid.Row="0"
                               Grid.Column="1"
                               Margin="0,0,0,10"
                               Text="Starting" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,0,0,10"
                               Opacity="0.65"
                               Text="Connection" />
                    <TextBlock x:Name="ConnectionValue"
                               Grid.Row="1"
                               Grid.Column="1"
                               Margin="0,0,0,10"
                               Text="Waiting" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Margin="0,0,0,10"
                               Opacity="0.65"
                               Text="Local receiver ID" />
                    <TextBlock x:Name="LocalPeerValue"
                               Grid.Row="2"
                               Grid.Column="1"
                               Margin="0,0,0,10"
                               FontFamily="Consolas"
                               Text="-" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Opacity="0.65"
                               Text="Controller peer" />
                    <TextBlock x:Name="RemotePeerValue"
                               Grid.Row="3"
                               Grid.Column="1"
                               FontFamily="Consolas"
                               Text="-" />
                </Grid>

                <Border Grid.Row="4"
                        Padding="16"
                        Background="#0D000000"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Opacity="0.6"
                                       Text="Transport" />
                            <TextBlock x:Name="TransportValue"
                                       Margin="0,4,0,0"
                                       FontWeight="SemiBold"
                                       Text="-" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Opacity="0.6"
                                       Text="RTT" />
                            <TextBlock x:Name="RttValue"
                                       Margin="0,4,0,0"
                                       FontWeight="SemiBold"
                                       Text="-" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Opacity="0.6"
                                       Text="Jitter" />
                            <TextBlock x:Name="JitterValue"
                                       Margin="0,4,0,0"
                                       FontWeight="SemiBold"
                                       Text="-" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Opacity="0.6"
                                       Text="Packet loss" />
                            <TextBlock x:Name="LossValue"
                                       Margin="0,4,0,0"
                                       FontWeight="SemiBold"
                                       Text="-" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
