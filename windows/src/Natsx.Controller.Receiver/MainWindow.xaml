<Window x:Class="Natsx.Controller.Receiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NATSX Controller Receiver"
        Width="780"
        Height="650"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="NATSX Controller" />
                <TextBlock Margin="0,6,0,0"
                           Opacity="0.7"
                           Text="Windows Receiver" />
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="20"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="Receiver status" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.78"
                               Text="Starting receiver…" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="16"
                        BorderBrush="#22000000"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="Virtual Xbox" />
                        <TextBlock x:Name="VirtualControllerText"
                                   Margin="0,6,0,0"
                                   Opacity="0.72"
                                   Text="Starting…" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="16"
                        BorderBrush="#22000000"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="Wi-Fi receiver" />
                        <TextBlock x:Name="WifiText"
                                   Margin="0,6,0,0"
                                   Opacity="0.72"
                                   Text="Starting…" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Padding="16"
                        BorderBrush="#22000000"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="Controller session" />
                        <TextBlock x:Name="SessionText"
                                   Margin="0,6,0,0"
                                   Opacity="0.72"
                                   Text="Waiting…" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="6"
                    Padding="16"
                    BorderBrush="#22000000"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Connection diagnostics" />
                    <TextBlock x:Name="DiagnosticsText"
                               Margin="0,8,0,0"
                               Opacity="0.72"
                               Text="RTT --   Jitter --   Loss --   Health --" />
                </StackPanel>
            </Border>

            <Border Grid.Row="8"
                    Padding="18"
                    BorderBrush="#22000000"
                    BorderThickness="1"
                    CornerRadius="12">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="Pair a phone" />
                            <TextBlock Margin="0,5,0,0"
                                       Opacity="0.68"
                                       Text="Compare the same 6-digit code on both devices before confirming." />
                        </StackPanel>

                        <Button x:Name="StartPairingButton"
                                DockPanel.Dock="Right"
                                MinWidth="120"
                                Height="34"
                                Margin="20,0,0,0"
                                Click="StartPairingButton_Click"
                                Content="Pair new phone" />
                    </DockPanel>

                    <Border Margin="0,16,0,0"
                            Padding="16"
                            Background="#0A000000"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock x:Name="PairingInfoText"
                                       Text="Pairing is idle."
                                       Opacity="0.72"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="PairingCodeText"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="34"
                                       FontWeight="SemiBold"
                                       Text="------" />

                            <StackPanel Margin="0,14,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <Button x:Name="ConfirmPairingButton"
                                        Width="110"
                                        Height="34"
                                        Margin="0,0,8,0"
                                        IsEnabled="False"
                                        Click="ConfirmPairingButton_Click"
                                        Content="Codes match" />
                                <Button x:Name="CancelPairingButton"
                                        Width="90"
                                        Height="34"
                                        IsEnabled="False"
                                        Click="CancelPairingButton_Click"
                                        Content="Cancel" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
